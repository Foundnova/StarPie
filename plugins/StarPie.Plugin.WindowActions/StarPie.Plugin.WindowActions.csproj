<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarPie 随包动作包：窗口动作
    ==================================================================
    与 BasicActions 同属「主程序功能的物理拆分」，不是 samples/ 那种演示插件。
    它认领了五个顶层动作类型（见下面的 StarPiePluginTypeClaims）：
    Tile / ToggleTopmost / MoveMonitor / WindowOpacity / SwitchWindow ——
    用户在配置里写的 Type="Tile" 等，今后由这个程序集负责执行。

    **为什么把窗口类单独拆一个包**（而不是并进 BasicActions）：
    拆包的唯一正当理由是「用户会想单独关掉它」，而这一批正好有：
    它们的后果是「用户正在用的窗口被挪走 / 被置顶 / 被改透明 / 被切走」，
    与「启动程序、打开网址」完全不是一类风险。合在一个包里，
    想关掉「乱动我窗口」的用户只能连打开网页一起关掉。

    三条与社区插件完全相同的约束（照抄自 samples/HelloAction）：
      1. TargetFramework 不得高于宿主；
      2. ProjectReference 必须 Private=false —— 否则产物里会多出一份
         StarPie.Plugin.Abstractions.dll，两份类型身份会让所有强转失败；
      3. 只能引用 SDK 与 BCL，**绝不引用主程序 StarPie.dll**。

    第 3 条对它是硬约束：这个包存在的意义就是证明「宿主自己的动作真的能靠 SDK
    独立跑起来」。窗口控制是很好的检验 —— 宿主只通过 IHostWindowService 给出能力，
    连窗体的布局码清单都是运行时从服务读的，插件里没有一处 P/Invoke。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>StarPie.Plugin.WindowActions</AssemblyName>
    <RootNamespace>StarPie.Plugin.WindowActions</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>StarPie 窗口动作包</Product>
    <Company>StarPie Studio</Company>
    <Description>随 StarPie 分发的内置动作：平铺窗口、窗口置顶、窗口透明度、移到下一屏、切换窗口。可在「插件」页停用。</Description>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：不把 SDK 程序集复制到输出目录。生产物里必须只有这一枚 dll。 -->
    <ProjectReference Include="..\..\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    程序集元数据。随包插件走「裸 DLL」分发形态（来源区约定是扁平且只放 .dll），
    所以这些特性就是它的全部自描述信息，宿主靠静态读 PE 元数据识别它，不执行任何代码。
  -->
  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="starpie.builtin.windowactions" />
    <AssemblyMetadata Include="StarPiePluginName" Value="StarPie 窗口动作" />
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="WindowControl" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/SoftBlack42/StarPie" />

    <!--
      顶层动作类型认领。格式：分号分隔的「用户配置里的 Type 名=本插件内的贡献点短 ID」。
      右侧的短 ID 必须与 WindowActionsPlugin.Initialize 里注册的 Descriptor.Id 逐字一致 ——
      对不上的表现是「认领条目存在、指向的贡献点却不存在」，按下去只得到一句
      「插件没提供这个动作」，且不会有任何报错提示是清单写错了。

      这五个类型都没有历史别名：它们从第一版起就只叫这一个名字
      （与 Launch/Url、Folder/OpenFolder 那两对不一样）。
    -->
    <AssemblyMetadata Include="StarPiePluginTypeClaims" Value="Tile=tile;ToggleTopmost=toggleTopmost;MoveMonitor=moveMonitor;WindowOpacity=windowOpacity;SwitchWindow=switchWindow" />
  </ItemGroup>

</Project>
