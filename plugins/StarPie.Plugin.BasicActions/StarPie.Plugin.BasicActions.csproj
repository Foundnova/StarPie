<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarPie 随包动作包：基础动作
    ==================================================================
    这个工程与 samples/ 下的示例插件**不是一类东西**，别看它们长得很像：

      · samples/     面向社区，演示「第三方插件能做什么」，可以随便拆掉；
      · plugins/     随主程序分发，是**主程序功能的物理拆分**。它认领了
                     Launch / WebUrl / Folder 三个顶层动作类型（见下面的
                     StarPiePluginTypeClaims），用户在配置里写的 Type="Launch"
                     今后由这个程序集负责执行。

    它必须遵守与社区插件完全相同的三条约束（照抄自 samples/HelloAction）：
      1. TargetFramework 不得高于宿主；
      2. ProjectReference 必须 Private=false —— 否则产物里会多出一份
         StarPie.Plugin.Abstractions.dll，两份类型身份会让所有强转失败；
      3. 只能引用 SDK 与 BCL，**绝不引用主程序 StarPie.dll**。

    第 3 条对它是硬约束，不是建议：这个包的全部意义就是证明「主程序的动作
    真的能靠 SDK 独立跑起来」。一旦它偷偷引用了 StarPie.dll，这个证明就失效了。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>StarPie.Plugin.BasicActions</AssemblyName>
    <RootNamespace>StarPie.Plugin.BasicActions</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>StarPie 基础动作包</Product>
    <Company>StarPie Studio</Company>
    <Description>随 StarPie 分发的内置动作：启动程序、打开网址、打开文件夹。可在「插件」页停用。</Description>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：不把 SDK 程序集复制到输出目录。生产物里必须只有这一枚 dll。 -->
    <ProjectReference Include="..\..\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    程序集元数据。随包插件走「裸 DLL」分发形态（来源区约定是扁平且只放 .dll），
    所以这些特性就是它的全部自描述信息，宿主靠静态读 PE 元数据识别它，不执行任何代码。
  -->
  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="starpie.builtin.basicactions" />
    <AssemblyMetadata Include="StarPiePluginName" Value="StarPie 基础动作" />
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="Process;Ui" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/SoftBlack42/StarPie" />

    <!--
      顶层动作类型认领。格式：分号分隔的「用户配置里的 Type 名=本插件内的贡献点短 ID」。
      OpenFolder / Url 是历史上出现过的别名写法，老配置里可能有，所以一并认领 ——
      少认领一个的表现是「同一个动作时灵时不灵」，而且不会有任何报错。
    -->
    <AssemblyMetadata Include="StarPiePluginTypeClaims" Value="Launch=launch;WebUrl=webUrl;Url=webUrl;Folder=folder;OpenFolder=folder" />
  </ItemGroup>

</Project>
