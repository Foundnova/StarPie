<Window x:Class="Issue17Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StarPie - Issue #17 轮盘浮动名称显示交互实验原型 (Prototype Demo)"
        Width="1160" Height="780"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    
    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- RadioButton Button Style -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Margin="0,0,6,6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#131B2E" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" MinWidth="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: CONTROLS & COMPARISONS -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                <StackPanel>
                    <!-- Header -->
                    <Border Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="6" Background="#0284C7" Margin="0,0,8,0">
                                    <TextBlock Text="✦" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Issue #17 需求与效果实验台" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="轮盘浮动显示名称与操作体验对比原型" FontSize="11" Foreground="#64748B" Margin="34,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 1: Display Mode Comparison -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🎯 核心对比：名称显示模式" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                            </StackPanel>
                            <TextBlock Text="切换不同方案，观察右侧轮盘的光标交互感受：" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />

                            <RadioButton Name="ModeCursorFollowRadio" Style="{StaticResource SegmentedRadioButtonStyle}" 
                                         IsChecked="True" Checked="ModeRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀 模式 A: 光标伴随浮动标签 (Cursor Follow)" FontWeight="Medium" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock Text="光标移入扇区时，精致标签伴随光标悬浮，视线无需转移。" FontSize="11" Foreground="#64748B" Margin="6,-2,0,8" />

                            <RadioButton Name="ModeOuterAnchorRadio" Style="{StaticResource SegmentedRadioButtonStyle}" 
                                         Checked="ModeRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛰️ 模式 B: 扇区外沿径向锚定 (Outer Anchor)" FontWeight="Medium" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock Text="标签吸附在扇区外圆弧切线正前方，如同雷达锁定指示器。" FontSize="11" Foreground="#64748B" Margin="6,-2,0,8" />

                            <RadioButton Name="ModeCenterCoreRadio" Style="{StaticResource SegmentedRadioButtonStyle}" 
                                         Checked="ModeRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 模式 C: 轮盘中心显示 (PR #37 现状)" FontWeight="Medium" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock Text="在中心核心圆内显示文字（需转头看中心，长文本易截断）。" FontSize="11" Foreground="#64748B" Margin="6,-2,0,8" />

                            <RadioButton Name="ModeInlineSectorRadio" Style="{StaticResource SegmentedRadioButtonStyle}" 
                                         Checked="ModeRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ 模式 D: 原版扇区内嵌文字 (现状溢出)" FontWeight="Medium" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock Text="Issue #17 指出的现状：8/12 扇区内文字极度拥挤并截断溢出。" FontSize="11" Foreground="#64748B" Margin="6,-2,0,2" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Wheel Layout & Sectors -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="⚙️ 轮盘排版与扇区档位" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,8" />

                            <!-- Sector Count -->
                            <TextBlock Text="扇区数量 (Sector Count):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <WrapPanel Margin="0,0,0,8">
                                <RadioButton Name="Sectors4Radio" Content="4 扇区 (四字键)" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SectorsRadio_Checked" />
                                <RadioButton Name="Sectors8Radio" Content="8 扇区 (经典档)" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="SectorsRadio_Checked" />
                                <RadioButton Name="Sectors12Radio" Content="12 扇区 (密集档)" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SectorsRadio_Checked" />
                            </WrapPanel>

                            <!-- Layout Mode -->
                            <TextBlock Text="轮盘内部排版 (Layout Mode):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <WrapPanel Margin="0,0,0,4">
                                <RadioButton Name="LayoutIconOnlyRadio" Content="纯图标 (推荐搭配浮动)" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="LayoutRadio_Checked" />
                                <RadioButton Name="LayoutIconAndTextRadio" Content="图标 + 文字" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="LayoutRadio_Checked" />
                                <RadioButton Name="LayoutTextOnlyRadio" Content="纯文字" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="LayoutRadio_Checked" />
                            </WrapPanel>
                            <TextBlock Text="* 搭配浮动标签时，纯图标模式最能达到极简干净与清晰提示的完美平衡。" FontSize="10.5" Foreground="#0EA5E9" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Floating Tooltip Options -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="🎨 浮动微标样式与辅助信息" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,8" />

                            <CheckBox Name="ShowHotkeyChipCheckBox" Content="显示快捷键微标 (如 [Ctrl+C])" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox Name="ShowCategoryTagCheckBox" Content="显示动作类型微标 (如 [系统/窗口])" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox Name="EnableSmoothLerpCheckBox" Content="启用光标跟随弹性缓动 (Smooth Lerp)" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox Name="ShowConnectingLineCheckBox" Content="显示径向连接导线 (仅外沿锚定模式)" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="浮动标签字号:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <TextBlock Name="FontSizeLabel" Grid.Column="1" Text="12.5 px" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Name="FontSizeSlider" Minimum="10" Maximum="16" Value="12.5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="FontSizeSlider_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Evaluation Summary -->
                    <Border Style="{StaticResource CardBorderStyle}" Background="#161F36" BorderBrush="#0284C7">
                        <StackPanel>
                            <TextBlock Text="💡 体验分析与技术结论" FontWeight="SemiBold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,6" />
                            <TextBlock Text="1. 模式 A (伴随光标) 视线无位移，击发确认感最强，适合快速盲操甩动手势；" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="2. 模式 B (扇区外沿) 视觉最规整高级，完全不遮挡轮盘与光标，类似雷达HUD锁定；" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="3. 与【纯图标】排版组合，可同时彻底根治 Issue #17 扇区空间拥挤与新手记忆成本两大致命痛点。" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT PANEL: INTERACTIVE WHEEL CANVAS -->
        <Grid Grid.Column="1" Background="#080C15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Tip Bar -->
            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Background="#0369A1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="LIVE INTERACTIVE" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock Text="移动鼠标划入轮盘扇区，体验浮动效果" FontSize="11.5" Foreground="#E2E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Name="CurrentModeBanner" Text="当前模式: 🚀 光标伴随浮动标签" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Wheel Interactive Canvas -->
            <Canvas Grid.Row="1" Name="WheelCanvas" ClipToBounds="True" Background="Transparent"
                    MouseMove="WheelCanvas_MouseMove" MouseLeave="WheelCanvas_MouseLeave" MouseDown="WheelCanvas_MouseDown">
                
                <!-- Background Grid Coordinates / Subtle rings -->
                <Ellipse Name="RulerOuterEllipse" Width="360" Height="360" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="4 4" IsHitTestVisible="False" />
                <Ellipse Name="RulerInnerEllipse" Width="100" Height="100" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="2 2" IsHitTestVisible="False" />
                <Line Name="RulerAxisX" Stroke="#131F37" StrokeThickness="1" IsHitTestVisible="False" />
                <Line Name="RulerAxisY" Stroke="#131F37" StrokeThickness="1" IsHitTestVisible="False" />

                <!-- Sectors Container -->
                <Canvas Name="SectorsCanvas" IsHitTestVisible="False" />

                <!-- Connecting Line for Mode B (Outer Anchor) -->
                <Line Name="ConnectingLine" Stroke="#38BDF8" StrokeThickness="1.5" StrokeDashArray="2 2" Opacity="0" IsHitTestVisible="False" />

                <!-- Center Core Circle -->
                <Grid Name="CenterCoreGrid" Width="80" Height="80" IsHitTestVisible="False">
                    <Ellipse Fill="#1E293B" Stroke="#334155" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000000" Opacity="0.5" />
                        </Ellipse.Effect>
                    </Ellipse>
                    
                    <!-- Center Normal Content -->
                    <StackPanel Name="CenterNormalPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                        <TextBlock Text="死区" FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Center Text Mode Content (Mode C - PR #37) -->
                    <Grid Name="CenterSelectionGrid" Visibility="Collapsed">
                        <Ellipse Fill="#0F172ACC" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4">
                            <TextBlock Name="CenterActionIcon" Text="📋" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,2" />
                            <TextBlock Name="CenterActionTitle" Text="复制选中" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" 
                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Floating Tooltip HUD (Mode A: Cursor Follow & Mode B: Outer Anchor) -->
                <Border Name="FloatingHudPill" CornerRadius="18" Background="#0F172AF0" BorderBrush="#38BDF8" BorderThickness="1.5"
                        Padding="10,6,12,6" Opacity="0" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#0284C7" Opacity="0.6" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Action Icon Badge -->
                        <Border Name="HudIconBorder" Width="26" Height="26" CornerRadius="13" Background="#1E293B" Margin="0,0,8,0">
                            <TextBlock Name="HudIconText" Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Action Texts -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="HudActionTitle" Text="系统管理工具" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <Border Name="HudCategoryBorder" Background="#0284C7" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Name="HudCategoryText" Text="系统" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Name="HudActionDesc" Text="打开 Windows 快捷高级系统菜单" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Hotkey Chip -->
                        <Border Name="HudHotkeyChip" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Name="HudHotkeyText" Text="Win + X" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" FontFamily="Consolas, Segoe UI" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Click Feedback Ripple -->
                <Ellipse Name="ClickRipple" Width="10" Height="10" Stroke="#38BDF8" StrokeThickness="2" Fill="#38BDF833" Opacity="0" IsHitTestVisible="False" />
            </Canvas>

            <!-- Bottom Real-Time Telemetry & Status Bar -->
            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前捕获扇区: " FontSize="11.5" Foreground="#64748B" />
                        <TextBlock Name="StatusSectorText" Text="未激活 (死区)" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,16,0" />
                        
                        <TextBlock Text="极坐标角度: " FontSize="11.5" Foreground="#64748B" />
                        <TextBlock Name="StatusAngleText" Text="0.0°" FontSize="11.5" Foreground="#38BDF8" Margin="0,0,16,0" />
                        
                        <TextBlock Text="划动位移: " FontSize="11.5" Foreground="#64748B" />
                        <TextBlock Name="StatusDistText" Text="0.0 px" FontSize="11.5" Foreground="#38BDF8" />
                    </StackPanel>

                    <TextBlock Name="StatusExecutionLog" Grid.Column="1" Text="提示: 点击任意扇区可模拟触发击发反馈" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" />
                        <TextBlock Text="实时渲染 120FPS" FontSize="11" Foreground="#10B981" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
