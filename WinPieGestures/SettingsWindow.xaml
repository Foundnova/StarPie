                  <TextBlock Name="OuterEscapeDescText" Text="手势划出后若想放弃，无需拉回中心，直接顺势向外快速划出即可安全取消，0 误触。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />
