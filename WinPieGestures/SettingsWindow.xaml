                      <Button Name="ResetDefaultTriggerButton" AutomationProperties.AutomationId="ResetDefaultTriggerButton" Content="🔄 恢复默认 (鼠标右键)" Height="36" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource ModernButtonStyle}" Cursor="Hand" Click="ResetDefaultTriggerButton_Click" />
