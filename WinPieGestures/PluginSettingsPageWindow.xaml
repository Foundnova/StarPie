<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WinPieGestures.PluginSettingsPageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="插件设置" Icon="app_icon.ico" Height="560" Width="480" MinHeight="360" MinWidth="400" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei UI, Arial">
  <!--
    本窗口只负责「壳」：标题、说明、滚动容器、校验行、关闭按钮。
    字段一律由 PluginParameterForm 用代码创建 —— 它在扇区编辑器里已经跑了很久，
    深浅色、圆角、必填星号、取色器、文件夹浏览都在那里统一维护。
    隐式样式（TextBox / CheckBox / ComboBox / HotkeyRecorderBox）与 ModernButtonStyle
    都定义在 App.xaml 里，因此本窗口不必重复声明；只有主按钮样式是本地私有的。
  -->
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
      <TextBlock Name="DescriptionText" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="FormPanel" />
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Name="ValidationText" FontSize="11" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
      <!-- 没有「保存」也没有「取消」：字段是写穿的，改了即刻生效（见代码注释）。
           关闭即落盘，因此 Esc / 右上角 × / 这个按钮三条路径都只需走 OnClosed。 -->
      <Button Name="CloseButton" Grid.Column="1" Content="关闭" Style="{StaticResource PrimaryBtn}" Height="30" Padding="16,0" HorizontalAlignment="Right" IsCancel="True" />
    </Grid>
  </Grid>
</Window>
