<Window x:Class="WinPieGestures.ScreenSnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StarPie 截屏框选"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#20000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Focusable="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas Name="SnipCanvas" Background="Transparent">
        <!-- 框选矩形 -->
        <Rectangle Name="SelectionRect"
                   Stroke="#06b6d4"
                   StrokeThickness="2"
                   StrokeDashArray="4 2"
                   Fill="#2606b6d4"
                   Visibility="Collapsed" />

        <!-- 尺寸与提示浮标 -->
        <Border Name="InfoBadge"
                Background="#EE0F172A"
                BorderBrush="#4006B6D4"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="SizeTextBlock" Text="0 × 0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0" />
                <TextBlock Text="松开识别 · ESC 取消" FontSize="10" Foreground="#94A3B8" />
            </StackPanel>
        </Border>

        <!-- 顶部操作指南 -->
        <Border Canvas.Top="30"
                HorizontalAlignment="Center"
                Background="#D90F172A"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✂️ 鼠标拖拽框选文字区域" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,12,0" />
                <TextBlock Text="[ESC] 退出" FontSize="11" Foreground="#94A3B8" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
