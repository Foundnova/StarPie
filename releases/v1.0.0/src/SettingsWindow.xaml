<Window x:Class="WinPieGestures.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPieGestures - 鼠标轮盘笔势设置" 
        Height="550" Width="800"
        Background="#F4F4F9"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#3F51B5" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WinPieGestures" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Windows 全局应用感知鼠标轮盘笔势工具" Foreground="#D0FFFFFF" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v1.0" Foreground="#A0FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Pane: Profiles -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="应用配置文件" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"/>
                    
                    <ListBox Grid.Row="1" Name="ProfilesListBox" BorderThickness="0" Background="Transparent" 
                             SelectionChanged="ProfilesListBox_SelectionChanged" DisplayMemberPath="ProcessName"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#103F51B5"/>
                                        <Setter Property="Foreground" Value="#3F51B5"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="添加配置" Margin="0,0,5,0" Height="28" Background="#E0E0E0" BorderThickness="0" Click="AddProfile_Click"/>
                        <Button Grid.Column="1" Content="删除配置" Margin="5,0,0,0" Height="28" Background="#E0E0E0" BorderThickness="0" Click="DeleteProfile_Click"/>
                    </Grid>
                </Grid>
            </Border>
            
            <!-- Splitter Grid -->
            <Grid Grid.Column="1" Width="15"/>
            
            <!-- Right Pane: Slots Details -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15">
                <Grid>
                    <Grid Name="DetailsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Profile Info -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="进程名:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Name="ProcessNameTextBox" Height="26" VerticalContentAlignment="Center" TextChanged="ProcessNameTextBox_TextChanged"/>
                        
                        <TextBlock Grid.Column="2" Text="轮盘键数:" VerticalAlignment="Center" FontWeight="Bold" Margin="15,0,10,0"/>
                        <ComboBox Grid.Column="3" Name="SectorCountComboBox" Height="26" SelectionChanged="SectorCountComboBox_SelectionChanged">
                            <ComboBoxItem Content="4 键" Tag="4"/>
                            <ComboBoxItem Content="8 键" Tag="8"/>
                            <ComboBoxItem Content="12 键" Tag="12"/>
                        </ComboBox>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,5,0,15"/>

                    <!-- Directions List -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Table Headers -->
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/> <!-- Direction -->
                                <ColumnDefinition Width="120"/> <!-- Label/Name -->
                                <ColumnDefinition Width="80"/> <!-- Type -->
                                <ColumnDefinition Width="120"/> <!-- Parameter -->
                                <ColumnDefinition Width="90"/> <!-- Args -->
                                <ColumnDefinition Width="*"/> <!-- Test -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="方向" FontWeight="Bold" Foreground="#666666"/>
                            <TextBlock Grid.Column="1" Text="显示文字" FontWeight="Bold" Foreground="#666666"/>
                            <TextBlock Grid.Column="2" Text="类型" FontWeight="Bold" Foreground="#666666"/>
                            <TextBlock Grid.Column="3" Text="参数" FontWeight="Bold" Foreground="#666666"/>
                            <TextBlock Grid.Column="4" Text="参数(运行)" FontWeight="Bold" Foreground="#666666"/>
                        </Grid>
                        
                        <!-- Slots Data Rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                            <ItemsControl Name="SlotsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>  <!-- Direction -->
                                                    <ColumnDefinition Width="120"/> <!-- Name -->
                                                    <ColumnDefinition Width="80"/>  <!-- Type -->
                                                    <ColumnDefinition Width="120"/> <!-- Parameter -->
                                                    <ColumnDefinition Width="90"/>  <!-- Args -->
                                                    <ColumnDefinition Width="*"/>   <!-- Test -->
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding DirectionName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Action.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         Margin="0,0,5,0" Height="24" VerticalContentAlignment="Center"/>
                                                
                                                <ComboBox Grid.Column="2" SelectedValue="{Binding Action.Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                          SelectedValuePath="Tag" Margin="0,0,5,0" Height="24">
                                                    <ComboBoxItem Content="模拟热键" Tag="Hotkey"/>
                                                    <ComboBoxItem Content="启动程序" Tag="Launch"/>
                                                    <ComboBoxItem Content="系统控制" Tag="System"/>
                                                </ComboBox>
                                                
                                                <TextBox Grid.Column="3" Text="{Binding Action.Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         Margin="0,0,5,0" Height="24" VerticalContentAlignment="Center"/>
                                                
                                                <TextBox Grid.Column="4" Text="{Binding Action.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         IsEnabled="{Binding IsLaunchType}" Margin="0,0,5,0" Height="24" VerticalContentAlignment="Center"/>
                                                
                                                <Button Grid.Column="5" Content="测试" Height="24" Padding="5,0" Click="Test_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                
                    <TextBlock Name="SelectProfilePlaceholder" Text="请在左侧选择或添加一个配置文件进行设置" 
                               Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom bar (Save / Options) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="触发位移阈值 (像素):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Name="ThresholdSlider" Width="150" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" 
                        ValueChanged="ThresholdSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock Name="ThresholdValueLabel" Text="25" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
            </StackPanel>
            
            <Button Grid.Column="1" Content="保存更改" Width="100" Height="32" Background="#3F51B5" Foreground="White" 
                    BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Grid.Column="2" Content="关闭" Width="80" Height="32" Background="#E0E0E0" BorderThickness="0" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
