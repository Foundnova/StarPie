<Window x:Class="WinPieGestures.RadialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadialWindow"
        Height="320" Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    
    <Window.Resources>
        <!-- Premium Radial Shadow -->
        <DropShadowEffect x:Key="RadialShadow" Color="#000000" BlurRadius="25" ShadowDepth="0" Opacity="0.45"/>
        <DropShadowEffect x:Key="TextShadow" Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
    </Window.Resources>
    
    <Grid Name="MainGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.5" ScaleY="0.5"/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        
        <!-- Outer Glowing Ring Border -->
        <Ellipse Width="286" Height="286" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.5">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
        </Ellipse>

        <!-- Main Canvas where slices and labels are drawn -->
        <Canvas Name="WheelCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource RadialShadow}">
            <!-- Center Glassmorphism Core -->
            <Grid Canvas.Left="100" Canvas.Top="100" Width="100" Height="100">
                <Ellipse Fill="#E0111115" Stroke="#30FFFFFF" StrokeThickness="1"/>
                
                <!-- Inner soft radial glow -->
                <Ellipse Margin="2">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#25FFFFFF" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                    <!-- Icon or process label -->
                    <TextBlock Name="CoreTitle" Text="WinPie" 
                               Foreground="#D0FFFFFF" FontSize="11" FontWeight="Bold" 
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Name="CoreSubtitle" Text="RMB Drag" 
                               Foreground="#80FFFFFF" FontSize="8" 
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Window>
