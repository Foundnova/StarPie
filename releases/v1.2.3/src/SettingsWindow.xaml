                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="WinPieGestures" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="v1.2.0-dev" FontWeight="Bold" Foreground="#1E40AF" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="高质感、极速现代 Windows 鼠标轮盘笔势工具" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="OpenChangelogButton" Grid.Column="2" Content="查看完整 CHANGELOG" Style="{StaticResource ModernButtonStyle}" VerticalAlignment="Center" Height="34" Click="OpenChangelogButton_Click"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: v1.2.0 Highlights -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
