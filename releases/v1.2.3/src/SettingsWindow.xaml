<Window x:Class="WinPieGestures.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinPieGestures"
        mc:Ignorable="d"
        Title="WinPieGestures 设置控制台 (Preferences)" Height="720" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Closing="Window_Closing"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                                <Setter Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                                <Setter Property="BorderBrush" Value="#172554"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat ComboBox Style -->
        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern iOS-style ToggleSwitch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Track" Background="#E2E8F0" CornerRadius="11" SnapsToDevicePixels="True"/>
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.15"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation RadioButton Style -->
        <Style x:Key="NavTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Hotkey Recorder Control Style -->
        <Style TargetType="{x:Type local:HotkeyRecorderBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:HotkeyRecorderBox}">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="8,2"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock x:Name="PART_DisplayText"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                           
                                <Button x:Name="PART_ClearButton"
                                        Grid.Column="1"
                                        Content="✕"
                                        Width="16" Height="16"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        FontSize="10"
                                        Foreground="#94A3B8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        ToolTip="清空快捷键"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="16,20,16,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Sidebar Header (Logo & Brand) -->
                <StackPanel Grid.Row="0" Margin="0,5,0,24">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Modern Pie Icon -->
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Ellipse Fill="#EBF5FF" Width="34" Height="34"/>
                            <Path Fill="#3B82F6" Stretch="Uniform" Margin="6"
                                  Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,4.06c3.95,0.49,7,3.85,7,7.94h-7V4.06z M11,4.06v7.94H4c0-4.09,3.05-7.45,7-7.94z M4,13h7v7.94c-3.95-0.49-7-3.85-7-7.94z M13,20.94V13h7C20,17.09,16.95,20.45,13,20.94z"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="WinPieGestures" FontSize="17" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <TextBlock Text="鼠标轮盘笔势管理系统" FontSize="11" Foreground="#64748B" Margin="2,0,0,0"/>
                </StackPanel>
                
                <!-- Five-Dimension Navigation RadioButtons -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavTab0" Style="{StaticResource NavTabRadioButtonStyle}" GroupName="SidebarTabs" Tag="0" IsChecked="True" Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RadioButton}, Path=Foreground}" 
                                  Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                            <TextBlock Text="🎯 触发与场景" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavTab1" Style="{StaticResource NavTabRadioButtonStyle}" GroupName="SidebarTabs" Tag="1" Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RadioButton}, Path=Foreground}" 
                                  Data="M12,3C7.03,3 3,7.03 3,12C3,16.97 7.03,21 12,21C12.83,21 13.5,20.33 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.49C12.88,18.23 12.73,17.88 12.73,17.5A1.5,1.5 0 0,1 14.23,16H16C18.76,16 21,13.76 21,11C21,6.58 16.97,3 12,3M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12Z"/>
                            <TextBlock Text="🎨 外观与形态" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavTab2" Style="{StaticResource NavTabRadioButtonStyle}" GroupName="SidebarTabs" Tag="2" Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RadioButton}, Path=Foreground}" 
                                  Data="M4,6c0-1.1,0.9-2,2-2h12c1.1,0,2,0.9,2,2v12c0,1.1-0.9,2-2,2H6c-1.1,0-2-0.9-2-2V6z M6,8h12V6H6V8z M6,12h12v-2H6V12z M6,16h6v-2H6V16z"/>
                            <TextBlock Text="⚡ 手势与动作" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavTab3" Style="{StaticResource NavTabRadioButtonStyle}" GroupName="SidebarTabs" Tag="3" Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RadioButton}, Path=Foreground}" 
                                  Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                            <TextBlock Text="⚙️ 高级与系统" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavTab4" Style="{StaticResource NavTabRadioButtonStyle}" GroupName="SidebarTabs" Tag="4" Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RadioButton}, Path=Foreground}" 
                                  Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                            <TextBlock Text="📋 关于与更新" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                
                <!-- Version Footer -->
                <StackPanel Grid.Row="2" Margin="0,15,0,5">
                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock Text="v1.2.0" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                    </Border>
                    <TextBlock Text="© 2026 WinPieGestures" FontSize="10" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Right Main Panel -->
        <Grid Grid.Column="1" Margin="25,25,25,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Tab Pages -->
            <Grid Grid.Row="0">
                <!-- ================= PAGE 0: TRIGGERS & SCENES ================= -->
                <Grid x:Name="TriggerSettingsGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="触发与场景隔离设置" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="在此配置全局鼠标手势的触发灵敏度、全屏游戏自动拦截与排除程序黑名单。" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 1: Trigger Sensitivity -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="手势触发灵敏度" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="按住鼠标右键移动超过指定像素距离后呼出手势轮盘。距离越小越灵敏，过小可能造成右键微抖动误触。" FontSize="12" Foreground="#64748B" Margin="0,2,0,12"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="ThresholdSlider" Minimum="10" Maximum="60" Value="25" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ThresholdSlider_ValueChanged"/>
                                        <TextBlock x:Name="ThresholdValueLabel" Grid.Column="1" Text="25" FontWeight="Bold" Foreground="#3B82F6" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Scene Isolation & Bypass -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="场景隔离与防误触" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="当处于特定场景或配合修饰键操作时，自动绕过轮盘拦截，放行原生右键事件。" FontSize="12" Foreground="#64748B" Margin="0,2,0,12"/>
                                    
                                    <CheckBox x:Name="DisableOnFullScreenCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,14" Checked="DisableOnFullScreenCheckBox_Changed" Unchecked="DisableOnFullScreenCheckBox_Changed">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="全屏游戏/独占应用自动禁用手势" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="自动检测当前前台窗口是否处于全屏独占状态，避免游戏瞄准等右键操作被拦截。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="快捷键旁路穿透 (按住以下修饰键拖拽时不触发手势):" FontSize="12" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <CheckBox x:Name="CtrlModifierCheckBox" Content="按住 Ctrl 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                                <CheckBox x:Name="ShiftModifierCheckBox" Content="按住 Shift 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                                <CheckBox x:Name="AltModifierCheckBox" Content="按住 Alt 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Process Exclusion Blacklist -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="进程排除黑名单" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="在排除名单中的应用程序（如远程桌面、画图、3D建模软件）中，完全放行鼠标右键。" FontSize="12" Foreground="#64748B" Margin="0,2,0,12"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewBlacklistProcessTextBox" Height="34" Margin="0,0,10,0"/>
                                        <Button x:Name="AddBlacklistButton" Grid.Column="1" Content="添加进程" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Click="AddBlacklistButton_Click"/>
                                    </Grid>

                                    <ListBox x:Name="BlacklistListBox" Height="110" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Margin="0,0,0,8"/>
                                    <Button x:Name="DeleteBlacklistButton" Content="移除选中的进程" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Height="30" Padding="12,0" Click="DeleteBlacklistButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= PAGE 1: APPEARANCE & LIVE CANVAS ================= -->
                <Grid x:Name="AppearanceSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="外观、主题与实时画布" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="微调轮盘视觉风格、几何形态、光学切缝与配色方案，右侧支持 60FPS 所见即所得交互测试。" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Split Pane: Left Config (1.15*) + Right Live Preview (1*) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Config Controls -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Theme & Style Preset -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="视觉风格与色彩" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="主题风格 (UiStyle):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="UiStyleComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="UiStyleComboBox_SelectionChanged">
                                            <ComboBoxItem Content="经典圆环 (Classic Ring)" Tag="ClassicRing" IsSelected="True"/>
                                            <ComboBoxItem Content="极简扇区 (Clean Sectors)" Tag="CleanSectors"/>
                                            <ComboBoxItem Content="液态毛玻璃 (Glassmorphism)" Tag="Glassmorphism"/>
                                            <ComboBoxItem Content="赛博霓虹 (Neon Glow HUD)" Tag="NeonGlow"/>
                                            <ComboBoxItem Content="萌宠猫爪 (Cute Cat Paw)" Tag="CatPaw"/>
                                            <ComboBoxItem Content="重工机械 (Mechanical)" Tag="Mechanical"/>
                                        </ComboBox>

                                        <TextBlock Text="配色方案 (Theme):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ThemeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="ThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统 (System Auto)" Tag="System" IsSelected="True"/>
                                            <ComboBoxItem Content="深色模式 (Dark)" Tag="Dark"/>
                                            <ComboBoxItem Content="浅色模式 (Light)" Tag="Light"/>
                                            <ComboBoxItem Content="赛博霓虹 (Cyber Neon)" Tag="CyberNeon"/>
                                            <ComboBoxItem Content="极光暮光 (Sunset Aurora)" Tag="SunsetAurora"/>
                                            <ComboBoxItem Content="抹茶森林 (Matcha Forest)" Tag="MatchaForest"/>
                                            <ComboBoxItem Content="熔岩烈焰 (Volcano Ember)" Tag="VolcanoEmber"/>
                                            <ComboBoxItem Content="典雅紫罗兰 (Royal Violet)" Tag="RoyalViolet"/>
                                            <ComboBoxItem Content="冰川透蓝 (Glacial Ice)" Tag="GlacialIce"/>
                                            <ComboBoxItem Content="莫兰迪柔灰 (Morandi Muted)" Tag="MorandiMuted"/>
                                            <ComboBoxItem Content="自定义高级配色 (Custom)" Tag="Custom"/>
                                        </ComboBox>

                                        <!-- Custom Colors Sub-Panel with Color Picker & Screen Eyedropper -->
                                        <StackPanel x:Name="CustomColorsPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                            <TextBlock Text="自定义十六进制色彩 (色盘调色 / 屏幕吸色):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                            
                                            <!-- Sector Normal Color -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="扇区底色:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBox x:Name="CustomSectorBgTextBox" Grid.Column="1" Height="28" TextChanged="CustomColorTextBox_TextChanged" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="CustomSectorBg" Click="PickCustomColor_Click" Style="{StaticResource ModernButtonStyle}">
                                                    <Border x:Name="CustomSectorBgPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                </Button>
                                                <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="CustomSectorBg" Click="PickEyedropper_Click" Style="{StaticResource ModernButtonStyle}"/>
                                            </Grid>

                                            <!-- Sector Normal Border -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="扇区边框:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBox x:Name="CustomSectorBorderTextBox" Grid.Column="1" Height="28" TextChanged="CustomColorTextBox_TextChanged" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="CustomSectorBorder" Click="PickCustomColor_Click" Style="{StaticResource ModernButtonStyle}">
                                                    <Border x:Name="CustomSectorBorderPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                </Button>
                                                <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="CustomSectorBorder" Click="PickEyedropper_Click" Style="{StaticResource ModernButtonStyle}"/>
                                            </Grid>

                                            <!-- Sector Highlight Color -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="高亮底色:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBox x:Name="CustomHighlightBgTextBox" Grid.Column="1" Height="28" TextChanged="CustomColorTextBox_TextChanged" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="CustomHighlightBg" Click="PickCustomColor_Click" Style="{StaticResource ModernButtonStyle}">
                                                    <Border x:Name="CustomHighlightBgPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                </Button>
                                                <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="CustomHighlightBg" Click="PickEyedropper_Click" Style="{StaticResource ModernButtonStyle}"/>
                                            </Grid>

                                            <!-- Sector Highlight Border -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="高亮边框:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBox x:Name="CustomHighlightBorderTextBox" Grid.Column="1" Height="28" TextChanged="CustomColorTextBox_TextChanged" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="CustomHighlightBorder" Click="PickCustomColor_Click" Style="{StaticResource ModernButtonStyle}">
                                                    <Border x:Name="CustomHighlightBorderPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                </Button>
                                                <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="CustomHighlightBorder" Click="PickEyedropper_Click" Style="{StaticResource ModernButtonStyle}"/>
                                            </Grid>

                                            <!-- Text Color -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="文字颜色:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBox x:Name="CustomTextTextBox" Grid.Column="1" Height="28" TextChanged="CustomColorTextBox_TextChanged" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="CustomText" Click="PickCustomColor_Click" Style="{StaticResource ModernButtonStyle}">
                                                    <Border x:Name="CustomTextPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                </Button>
                                                <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="CustomText" Click="PickEyedropper_Click" Style="{StaticResource ModernButtonStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Geometry Dimensions & Advanced Shapes -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="几何形态与尺寸微调" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,10,10"/>
                                        
                                        <!-- Shape Selector -->
                                        <TextBlock Text="扇区切削形态 (Shape):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ShapeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="ShapeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="经典紧凑扇区 (Original)" Tag="Original" IsSelected="True"/>
                                            <ComboBoxItem Content="独立圆形卡片 (Circle)" Tag="Circle"/>
                                            <ComboBoxItem Content="悬浮圆角矩形 (RoundedRect)" Tag="RoundedRect"/>
                                            <ComboBoxItem Content="悬浮独立胶囊 (FloatingCapsules)" Tag="FloatingCapsules"/>
                                            <ComboBoxItem Content="蜂巢六边形矩阵 (HexagonHive)" Tag="HexagonHive"/>
                                        </ComboBox>

                                        <!-- Sector Gap -->
                                        <TextBlock Text="扇区光学缝隙间距 (Gap):" FontSize="12" Foreground="#64748B"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SectorGapSlider" Minimum="0" Maximum="12" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SectorGapSlider_ValueChanged"/>
                                            <TextBlock x:Name="SectorGapLabel" Grid.Column="1" Text="2 px" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Sector Corner Radius / Fillet -->
                                        <TextBlock Text="扇区边缘平滑倒角 (Corner Radius):" FontSize="12" Foreground="#64748B"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SectorCornerRadiusSlider" Minimum="0" Maximum="16" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SectorCornerRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="SectorCornerRadiusLabel" Grid.Column="1" Text="4 px" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- Wheel Radius -->
                                        <TextBlock Text="轮盘整体半径 (外径):" FontSize="12" Foreground="#64748B"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="WheelRadiusSlider" Minimum="100" Maximum="200" Value="138" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="WheelRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="WheelRadiusLabel" Grid.Column="1" Text="138" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Inner Radius -->
                                        <TextBlock Text="扇区内半径 (Inner):" FontSize="12" Foreground="#64748B"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="InnerRadiusSlider" Minimum="30" Maximum="90" Value="52" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="InnerRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="InnerRadiusLabel" Grid.Column="1" Text="52" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Core Radius -->
                                        <TextBlock Text="中心核心圆半径 (Core):" FontSize="12" Foreground="#64748B"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="CoreRadiusSlider" Minimum="30" Maximum="80" Value="50" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="CoreRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="CoreRadiusLabel" Grid.Column="1" Text="50" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Wheel Backgrounds & Textures Customization -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="轮盘背景与自定义贴图" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                        <TextBlock Text="为整体轮盘、中心退出区和扇区高亮导入专属背景图片与纹理。" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                        <!-- 1. Global Wheel Background Image -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🌐 整体轮盘背景底图 (Global Background):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="WheelBgImageTextBox" Height="28" FontSize="11" VerticalContentAlignment="Center" TextChanged="WheelBgImageTextBox_TextChanged" Margin="0,0,4,0"/>
                                                    <Button Grid.Column="1" Content="..." Width="28" Height="28" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,0" ToolTip="选择轮盘背景图片" Click="BrowseWheelBg_Click"/>
                                                    <Button Grid.Column="2" Content="✕" Width="28" Height="28" Style="{StaticResource ModernButtonStyle}" ToolTip="清除背景图片" Click="ClearWheelBg_Click"/>
                                                </Grid>
                                                <Grid Margin="0,2,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="不透明度:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <Slider x:Name="WheelBgOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" ValueChanged="WheelBgOpacitySlider_ValueChanged" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="WheelBgOpacityLabel" Grid.Column="2" Text="80%" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="拉伸模式:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="WheelBgStretchComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="28" FontSize="11" SelectionChanged="WheelBgStretchComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="等比填满裁剪 (UniformToFill)" Tag="UniformToFill" IsSelected="True"/>
                                                        <ComboBoxItem Content="完整适应居中 (Uniform)" Tag="Uniform"/>
                                                        <ComboBoxItem Content="拉伸铺满 (Fill)" Tag="Fill"/>
                                                        <ComboBoxItem Content="原始尺寸居中 (None)" Tag="None"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. Center Core Area Image / Avatar / Logo -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🎯 中心核心区贴图/头像 (Core Area Image):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="CoreBgImageTextBox" Height="28" FontSize="11" VerticalContentAlignment="Center" TextChanged="CoreBgImageTextBox_TextChanged" Margin="0,0,4,0"/>
                                                    <Button Grid.Column="1" Content="..." Width="28" Height="28" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,0" ToolTip="选择中心核心贴图" Click="BrowseCoreBg_Click"/>
                                                    <Button Grid.Column="2" Content="✕" Width="28" Height="28" Style="{StaticResource ModernButtonStyle}" ToolTip="清除中心贴图" Click="ClearCoreBg_Click"/>
                                                </Grid>
                                                <Grid Margin="0,2,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="不透明度:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <Slider x:Name="CoreBgOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" ValueChanged="CoreBgOpacitySlider_ValueChanged" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="CoreBgOpacityLabel" Grid.Column="2" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="拉伸模式:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="CoreBgStretchComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="28" FontSize="11" SelectionChanged="CoreBgStretchComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="等比填满裁剪 (UniformToFill)" Tag="UniformToFill" IsSelected="True"/>
                                                        <ComboBoxItem Content="完整适应居中 (Uniform)" Tag="Uniform"/>
                                                        <ComboBoxItem Content="拉伸铺满 (Fill)" Tag="Fill"/>
                                                        <ComboBoxItem Content="原始尺寸居中 (None)" Tag="None"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Sector Highlight Texture -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="✨ 扇区高亮光效纹理 (Highlight Texture):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="HighlightTextureTextBox" Height="28" FontSize="11" VerticalContentAlignment="Center" TextChanged="HighlightTextureTextBox_TextChanged" Margin="0,0,4,0"/>
                                                    <Button Grid.Column="1" Content="..." Width="28" Height="28" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,0" ToolTip="选择高亮纹理贴图" Click="BrowseHighlightTexture_Click"/>
                                                    <Button Grid.Column="2" Content="✕" Width="28" Height="28" Style="{StaticResource ModernButtonStyle}" ToolTip="清除高亮纹理" Click="ClearHighlightTexture_Click"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="纹理透明:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <Slider x:Name="HighlightTextureOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70" ValueChanged="HighlightTextureOpacitySlider_ValueChanged" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="HighlightTextureOpacityLabel" Grid.Column="2" Text="70%" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Typography & Layout Options -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="图标与排版选项" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="排版模式 (Layout Mode):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="IconLayoutModeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="IconLayoutModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="图标 + 文字 (双行居中)" Tag="IconAndText" IsSelected="True"/>
                                            <ComboBoxItem Content="仅显示图标 (极大化居中)" Tag="IconOnly"/>
                                            <ComboBoxItem Content="仅显示文字 (纯文字居中)" Tag="TextOnly"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ShowTextCheckBox" Content="在轮盘扇区中显示动作名称文字" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0" Checked="ShowTextCheckBox_Changed" Unchecked="ShowTextCheckBox_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Live Interactive Preview Canvas -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="实时交互画布 (Live Preview)" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="60FPS 同步渲染" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="💡 移动鼠标至下方轮盘可实时测试高亮与磁吸手感" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Live Canvas Area -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" ClipToBounds="True" Margin="0,4,0,10">
                                    <Grid>
                                        <!-- Subtle grid texture lines -->
                                        <Path Stroke="#1E293B" StrokeThickness="0.5" Data="M0,150 L300,150 M150,0 L150,300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Interactive Live Canvas -->
                                        <Canvas x:Name="LiveWheelPreviewCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                MouseMove="LiveWheelPreviewCanvas_MouseMove" MouseLeave="LiveWheelPreviewCanvas_MouseLeave"/>
                                    </Grid>
                                </Border>

                                <!-- Quick Reset Button -->
                                <Button Grid.Row="2" Content="一键重置为推荐几何尺寸" Style="{StaticResource ModernButtonStyle}" Height="32" Click="ResetDimensionsButton_Click" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= PAGE 2: MAPPINGS & ACTIONS ================= -->
                <Grid x:Name="MappingsSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="手势方向与动作映射" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="支持针对不同前台应用程序设置专属的多向手势轮盘、按键动作与矢量图标。" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Profile Selection Card -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="当前配置方案 (Profile)" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="选择或新建针对特定程序（如 Chrome、VS Code）或特定工作流的轮盘配置方案（支持双击重命名）。" FontSize="12" Foreground="#64748B" Margin="0,2,0,10"/>
                                        <ListBox x:Name="ProfilesListBox" Height="100" SelectionChanged="ProfilesListBox_SelectionChanged" MouseDoubleClick="ProfilesListBox_MouseDoubleClick" DisplayMemberPath="ProcessName" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <Button x:Name="AddProfileButton" Content="新增专属程序配置" Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,0,0,5" Click="AddProfileButton_Click" ToolTip="从已安装软件或开始菜单中选择程序创建专属配置"/>
                                        <Button x:Name="AddCustomProfileButton" Content="新建自定义配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Click="AddCustomProfileButton_Click" ToolTip="自定义命名创建新的轮盘配置方案"/>
                                        <Button x:Name="RenameProfileButton" Content="重命名当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Click="RenameProfileButton_Click" ToolTip="重命名选中的配置方案"/>
                                        <Button x:Name="DeleteProfileButton" Content="删除当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" Click="DeleteProfileButton_Click" ToolTip="删除选中的配置方案"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sector Count Card -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="扇区方位数量 (Sector Count)" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="切换手势轮盘的切分数量。4 键最快最不易误触，8 键为标准全能方位，12 键适合功能密集场景。" FontSize="12" Foreground="#64748B" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SectorCount4Radio" Content="4 键十字方位" Margin="0,0,24,0" Checked="SectorCountRadio_Checked"/>
                                        <RadioButton x:Name="SectorCount8Radio" Content="8 键全向方位 (推荐)" Margin="0,0,24,0" IsChecked="True" Checked="SectorCountRadio_Checked"/>
                                        <RadioButton x:Name="SectorCount12Radio" Content="12 键钟表方位" Checked="SectorCountRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Sector Actions Mapping List -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="扇区动作映射列表" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="为每个方位指定触发动作与图标。支持热键组合（如 Ctrl+C）、启动本地程序与系统级操作。" FontSize="12" Foreground="#64748B" Margin="0,2,0,14"/>
                                    
                                    <ItemsControl x:Name="SlotsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Col 0: Direction -->
                                                        <TextBlock Text="{Binding DirectionLabel}" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" FontSize="12"/>
                                                        
                                                        <!-- Col 1: Icon Selector Button -->
                                                        <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="6,0" Margin="0,0,8,0" Click="PickIcon_Click" ToolTip="点击选取矢量图标">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="#2563EB" Margin="0,0,4,0"
                                                                      Data="{Binding VectorIconData}" Visibility="{Binding HasVectorIcon, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding IconDisplayText}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="52"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Col 2: Name Input -->
                                                        <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                                                        
                                                        <!-- Col 3: Type Selector -->
                                                        <ComboBox Grid.Column="3" SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Style="{StaticResource FlatComboBoxStyle}" Height="30" Margin="0,0,8,0" FontSize="12">
                                                            <ComboBoxItem Content="快捷热键" Tag="Hotkey"/>
                                                            <ComboBoxItem Content="启动程序" Tag="Launch"/>
                                                            <ComboBoxItem Content="系统控制" Tag="System"/>
                                                        </ComboBox>
                                                        
                                                        <!-- Col 4: Parameter Inputs -->
                                                        <Grid Grid.Column="4" Margin="0,0,8,0">
                                                            <!-- 1. Hotkey Interactive Recorder Box -->
                                                            <local:HotkeyRecorderBox HotkeyText="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>
                                                            
                                                            <!-- 2. Program Launch -->
                                                            <Grid Visibility="{Binding IsLaunchType, Converter={StaticResource BoolToVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         IsReadOnly="True" Background="#F1F5F9" Foreground="#475569" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="..." Width="28" Style="{StaticResource ModernButtonStyle}" Click="Browse_Click" Height="30"/>
                                                            </Grid>
                                                            
                                                            <!-- 3. System Preset -->
                                                            <ComboBox SelectedValue="{Binding SelectedSystemPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Key" DisplayMemberPath="Value"
                                                                      Style="{StaticResource FlatComboBoxStyle}"
                                                                      ItemsSource="{Binding Source={x:Static local:SlotViewModel.SystemPresets}}"
                                                                      Visibility="{Binding IsSystemType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>
                                                        </Grid>
                                                        
                                                        <!-- Col 5: Launch Arguments -->
                                                        <TextBox Grid.Column="5" Text="{Binding Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                 IsEnabled="{Binding IsLaunchType}" Margin="0,0,8,0" Height="30" FontSize="11" ToolTip="启动参数 (如命令行参数或URL)" VerticalContentAlignment="Center"/>
                                                        
                                                        <!-- Col 6: Test Button -->
                                                        <Button Grid.Column="6" Content="测试" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="12,0" Click="Test_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= PAGE 3: SYSTEM & ADVANCED ================= -->
                <Grid x:Name="SystemSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="高级系统与运维备份" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="管理 Windows 开机自启、管理员提权、钩子健康监视与配置文件的导入/导出备份。" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 1: Windows Auto-Start -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Windows 开机自启动" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="登录 Windows 系统时自动在后台静默启动 WinPieGestures，无需手动打开。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: UAC Privilege Elevation -->
                            <Border x:Name="UacWarningCard" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="管理员权限 (UAC Elevation)" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="当以普通权限运行时，无法在任务管理器、注册表编辑器等管理员窗口中注入鼠标笔势。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Content="以管理员权限重新启动" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Click="ElevatePrivileges_Click"/>
                                </Grid>
                            </Border>

                            <!-- Card 3: Hook Health Self-Healing -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="低级鼠标钩子健康自愈监视" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="内置 3000ms 心跳自愈线程。当 Windows 系统发生高负载或静默挂起底层钩子时，引擎将自动探测并无缝重载，无需重启软件。" FontSize="12" Foreground="#64748B" Margin="0,2,0,8"/>
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                        <TextBlock Text="● 钩子巡检状态: 正常运行 (Heartbeat Active)" FontSize="11" FontWeight="Medium" Foreground="#059669"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Backup & Recovery (JSON Export/Import) -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="配置文件备份与导入" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="将所有的自定义动作、配色、形态几何设置导出为 JSON 备份文件，或从备份文件中快速还原。" FontSize="12" Foreground="#64748B" Margin="0,2,0,12"/>
                                    <WrapPanel>
                                        <Button Content="导出当前配置为 JSON..." Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,10,0" Click="ExportConfigButton_Click"/>
                                        <Button Content="从外部 JSON 文件导入..." Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Click="ImportConfigButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

