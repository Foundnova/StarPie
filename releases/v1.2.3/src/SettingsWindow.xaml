                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="关于与更新日志" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="WinPieGestures 现代鼠标轮盘笔势工具版本信息与完整演进历程。" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
