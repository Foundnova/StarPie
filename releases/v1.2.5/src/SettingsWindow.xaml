                <Grid x:Name="TriggerSettingsGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="触发与场景隔离设置" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="在此配置全局鼠标手势的触发灵敏度、全屏游戏自动拦截与排除程序黑名单。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 1: Trigger Sensitivity -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="手势触发灵敏度" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="按住鼠标右键移动超过指定像素距离后呼出手势轮盘。距离越小越灵敏，过小可能造成右键微抖动误触。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="ThresholdSlider" Minimum="10" Maximum="60" Value="25" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ThresholdSlider_ValueChanged"/>
                                        <TextBlock x:Name="ThresholdValueLabel" Grid.Column="1" Text="25" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Scene Isolation & Bypass -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="场景隔离与防误触" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="当处于特定场景或配合修饰键操作时，自动绕过轮盘拦截，放行原生右键事件。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                    
                                    <CheckBox x:Name="DisableOnFullScreenCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,14" Checked="DisableOnFullScreenCheckBox_Changed" Unchecked="DisableOnFullScreenCheckBox_Changed">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="全屏游戏/独占应用自动禁用手势" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="自动检测当前前台窗口是否处于全屏独占状态，避免游戏瞄准等右键操作被拦截。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="快捷键旁路穿透 (按住以下修饰键拖拽时不触发手势):" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <CheckBox x:Name="CtrlModifierCheckBox" Content="按住 Ctrl 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                                <CheckBox x:Name="ShiftModifierCheckBox" Content="按住 Shift 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
