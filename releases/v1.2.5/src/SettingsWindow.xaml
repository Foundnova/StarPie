                                            <ComboBoxItem Content="液态毛玻璃 (Glassmorphism)" Tag="Glassmorphism"/>
                                            <ComboBoxItem Content="赛博霓虹 (Neon Glow HUD)" Tag="NeonGlow"/>
                                            <ComboBoxItem Content="萌宠猫爪 (Cute Cat Paw)" Tag="CatPaw"/>
                                            <ComboBoxItem Content="重工机械 (Mechanical)" Tag="Mechanical"/>
