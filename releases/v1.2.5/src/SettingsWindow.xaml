                                                    <Border x:Name="CustomTextPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                                                </Button>
                                                <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="CustomText" Click="PickEyedropper_Click" Style="{StaticResource ModernButtonStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Geometry Dimensions & Advanced Shapes -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="几何形态与尺寸微调" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,10"/>
                                        
                                        <!-- Shape Selector -->
                                        <TextBlock Text="扇区切削形态 (Shape):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ShapeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="ShapeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="经典紧凑扇区 (Original)" Tag="Original" IsSelected="True"/>
                                            <ComboBoxItem Content="独立圆形卡片 (Circle)" Tag="Circle"/>
                                            <ComboBoxItem Content="悬浮圆角矩形 (RoundedRect)" Tag="RoundedRect"/>
                                            <ComboBoxItem Content="悬浮独立胶囊 (FloatingCapsules)" Tag="FloatingCapsules"/>
                                            <ComboBoxItem Content="蜂巢六边形矩阵 (HexagonHive)" Tag="HexagonHive"/>
                                        </ComboBox>

                                        <!-- Sector Gap -->
                                        <TextBlock Text="扇区光学缝隙间距 (Gap):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SectorGapSlider" Minimum="0" Maximum="12" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SectorGapSlider_ValueChanged"/>
                                            <TextBlock x:Name="SectorGapLabel" Grid.Column="1" Text="2 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Sector Corner Radius / Fillet -->
                                        <TextBlock Text="扇区边缘平滑倒角 (Corner Radius):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SectorCornerRadiusSlider" Minimum="0" Maximum="16" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SectorCornerRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="SectorCornerRadiusLabel" Grid.Column="1" Text="4 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- Wheel Radius -->
                                        <TextBlock Text="轮盘整体半径 (外径):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="WheelRadiusSlider" Minimum="100" Maximum="200" Value="138" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="WheelRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="WheelRadiusLabel" Grid.Column="1" Text="138" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Inner Radius -->
                                        <TextBlock Text="扇区内半径 (Inner):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="InnerRadiusSlider" Minimum="30" Maximum="90" Value="52" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="InnerRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="InnerRadiusLabel" Grid.Column="1" Text="52" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Core Radius -->
                                        <TextBlock Text="中心核心圆半径 (Core):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="CoreRadiusSlider" Minimum="30" Maximum="80" Value="50" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="CoreRadiusSlider_ValueChanged"/>
                                            <TextBlock x:Name="CoreRadiusLabel" Grid.Column="1" Text="50" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Typography & Layout Options -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="图标与排版选项" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="排版模式 (Layout Mode):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="IconLayoutModeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="IconLayoutModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="图标 + 文字 (双行居中)" Tag="IconAndText" IsSelected="True"/>
                                            <ComboBoxItem Content="仅显示图标 (极大化居中)" Tag="IconOnly"/>
                                            <ComboBoxItem Content="仅显示文字 (纯文字居中)" Tag="TextOnly"/>
                                        </ComboBox>

                                        <CheckBox x:Name="ShowTextCheckBox" Content="在轮盘扇区中显示动作名称文字" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0" Checked="ShowTextCheckBox_Changed" Unchecked="ShowTextCheckBox_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Live Interactive Preview Canvas -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="实时交互画布 (Live Preview)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="60FPS 同步渲染" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="💡 移动鼠标至下方轮盘可实时测试高亮与磁吸手感" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Live Canvas Area -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" ClipToBounds="True" Margin="0,4,0,10">
                                    <Grid>
                                        <!-- Subtle grid texture lines -->
                                        <Path Stroke="#1E293B" StrokeThickness="0.5" Data="M0,150 L300,150 M150,0 L150,300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Interactive Live Canvas -->
                                        <Canvas x:Name="LiveWheelPreviewCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                MouseMove="LiveWheelPreviewCanvas_MouseMove" MouseLeave="LiveWheelPreviewCanvas_MouseLeave"/>
                                    </Grid>
                                </Border>

                                <!-- Quick Reset Button -->
                                <Button Grid.Row="2" Content="一键重置为推荐几何尺寸" Style="{StaticResource ModernButtonStyle}" Height="32" Click="ResetDimensionsButton_Click" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= PAGE 2: MAPPINGS & ACTIONS ================= -->
                <Grid x:Name="MappingsSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="手势方向与动作映射" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="支持针对不同前台应用程序设置专属的多向手势轮盘、按键动作与矢量图标。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Profile Selection Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="当前配置方案 (Profile)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="选择或新建针对特定程序（如 Chrome、VS Code）或特定工作流的轮盘配置方案（支持双击重命名）。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10"/>
                                        <ListBox x:Name="ProfilesListBox" Height="100" SelectionChanged="ProfilesListBox_SelectionChanged" MouseDoubleClick="ProfilesListBox_MouseDoubleClick" DisplayMemberPath="ProcessName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <Button x:Name="AddProfileButton" Content="新增专属程序配置" Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,0,0,5" Click="AddProfileButton_Click" ToolTip="从已安装软件或开始菜单中选择程序创建专属配置"/>
                                        <Button x:Name="AddCustomProfileButton" Content="新建自定义配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Click="AddCustomProfileButton_Click" ToolTip="自定义命名创建新的轮盘配置方案"/>
                                        <Button x:Name="RenameProfileButton" Content="重命名当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Click="RenameProfileButton_Click" ToolTip="重命名选中的配置方案"/>
                                        <Button x:Name="DeleteProfileButton" Content="删除当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" Click="DeleteProfileButton_Click" ToolTip="删除选中的配置方案"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sector Count Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="扇区方位数量 (Sector Count)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="切换手势轮盘的切分数量。4 键最快最不易误触，8 键为标准全能方位，12 键适合功能密集场景。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SectorCount4Radio" Content="4 键十字方位" Margin="0,0,24,0" Checked="SectorCountRadio_Checked"/>
                                        <RadioButton x:Name="SectorCount8Radio" Content="8 键全向方位 (推荐)" Margin="0,0,24,0" IsChecked="True" Checked="SectorCountRadio_Checked"/>
                                        <RadioButton x:Name="SectorCount12Radio" Content="12 键钟表方位" Checked="SectorCountRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Sector Actions Mapping List -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="扇区动作映射列表" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="为每个方位指定触发动作与图标。支持热键组合（如 Ctrl+C）、启动本地程序与系统级操作。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14"/>
                                    
                                    <ItemsControl x:Name="SlotsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Col 0: Direction -->
                                                        <TextBlock Text="{Binding DirectionLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                                                        
                                                        <!-- Col 1: Icon Selector Button -->
                                                        <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="6,0" Margin="0,0,8,0" Click="PickIcon_Click" ToolTip="点击选取矢量图标">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,4,0"
                                                                      Data="{Binding VectorIconData}" Visibility="{Binding HasVectorIcon, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding IconDisplayText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="52"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Col 2: Name Input -->
                                                        <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                                                        
                                                        <!-- Col 3: Type Selector -->
                                                        <ComboBox Grid.Column="3" SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Style="{StaticResource FlatComboBoxStyle}" Height="30" Margin="0,0,8,0" FontSize="12">
                                                            <ComboBoxItem Content="快捷热键" Tag="Hotkey"/>
                                                            <ComboBoxItem Content="启动程序" Tag="Launch"/>
                                                            <ComboBoxItem Content="系统控制" Tag="System"/>
                                                        </ComboBox>
                                                        
                                                        <!-- Col 4: Parameter Inputs -->
                                                        <Grid Grid.Column="4" Margin="0,0,8,0">
                                                            <!-- 1. Hotkey Interactive Recorder Box -->
                                                            <local:HotkeyRecorderBox HotkeyText="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>
                                                            
                                                            <!-- 2. Program Launch -->
                                                            <Grid Visibility="{Binding IsLaunchType, Converter={StaticResource BoolToVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         IsReadOnly="True" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="..." Width="28" Style="{StaticResource ModernButtonStyle}" Click="Browse_Click" Height="30"/>
                                                            </Grid>
                                                            
                                                            <!-- 3. System Preset -->
                                                            <ComboBox SelectedValue="{Binding SelectedSystemPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Key" DisplayMemberPath="Value"
                                                                      Style="{StaticResource FlatComboBoxStyle}"
                                                                      ItemsSource="{Binding Source={x:Static local:SlotViewModel.SystemPresets}}"
                                                                      Visibility="{Binding IsSystemType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>
                                                        </Grid>
                                                        
                                                        <!-- Col 5: Launch Arguments -->
                                                        <TextBox Grid.Column="5" Text="{Binding Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                 IsEnabled="{Binding IsLaunchType}" Margin="0,0,8,0" Height="30" FontSize="11" ToolTip="启动参数 (如命令行参数或URL)" VerticalContentAlignment="Center"/>
                                                        
                                                        <!-- Col 6: Test Button -->
                                                        <Button Grid.Column="6" Content="测试" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="12,0" Click="Test_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= PAGE 3: SYSTEM & ADVANCED ================= -->
                <Grid x:Name="SystemSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="高级系统与运维备份" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="管理 Windows 开机自启、管理员提权、钩子健康监视与配置文件的导入/导出备份。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 1: Windows Auto-Start -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Windows 开机自启动" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="登录 Windows 系统时自动在后台静默启动 WinPieGestures，无需手动打开。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: UAC Privilege Elevation -->
                            <Border x:Name="UacWarningCard" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="管理员权限 (UAC Elevation)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="当以普通权限运行时，无法在任务管理器、注册表编辑器等管理员窗口中注入鼠标笔势。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Content="以管理员权限重新启动" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Click="ElevatePrivileges_Click"/>
                                </Grid>
                            </Border>

                            <!-- Card 3: Hook Health Self-Healing -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="低级鼠标钩子健康自愈监视" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="内置 3000ms 心跳自愈线程。当 Windows 系统发生高负载或静默挂起底层钩子时，引擎将自动探测并无缝重载，无需重启软件。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                                    <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                        <TextBlock Text="● 钩子巡检状态: 正常运行 (Heartbeat Active)" FontSize="11" FontWeight="Medium" Foreground="#059669"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Backup & Recovery (JSON Export/Import) -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="配置文件备份与导入" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="将所有的自定义动作、配色、形态几何设置导出为 JSON 备份文件，或从备份文件中快速还原。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                    <WrapPanel>
                                        <Button Content="导出当前配置为 JSON..." Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,10,0" Click="ExportConfigButton_Click"/>
                                        <Button Content="从外部 JSON 文件导入..." Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Click="ImportConfigButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= PAGE 4: ABOUT & CHANGELOG ================= -->
                <Grid x:Name="AboutSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="关于与更新日志" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="WinPieGestures 现代鼠标轮盘笔势工具版本信息与完整演进历程。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
