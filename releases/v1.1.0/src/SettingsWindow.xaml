<Window x:Class="WinPieGestures.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinPieGestures"
        Title="WinPieGestures - 鼠标轮盘笔势设置" 
        Height="680" Width="1050"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                            <Grid Width="42" Height="22">
                                <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="11" SnapsToDevicePixels="True"/>
                                <Border x:Name="Thumb" Background="White" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#20000000"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ContentPresenter x:Name="contentPresenter" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="Track" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="Track" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Flat TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="SelectionBrush" Value="#93C5FD"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" 
                    Background="White" 
                    BorderBrush="#CBD5E1" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" 
                          Grid.Column="1" 
                          Fill="#64748B" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                    <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Custom Flat ComboBox Style -->
        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,6,30,6" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinHeight="20"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder" 
                                            Background="White" 
                                            BorderBrush="#E2E8F0" 
                                            BorderThickness="1" 
                                            CornerRadius="6"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#15000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Thumb Style -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ellipse" 
                                 Width="14" Height="14" 
                                 Fill="#3B82F6" 
                                 Stroke="White" 
                                 StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#30000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ellipse" Property="Fill" Value="#2563EB"/>
                                <Setter TargetName="ellipse" Property="Width" Value="16"/>
                                <Setter TargetName="ellipse" Property="Height" Value="16"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="ellipse" Property="Fill" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Slider Style -->
        <Style x:Key="FlatSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground" 
                                    Grid.Row="1" 
                                    Height="6" 
                                    Background="#E2E8F0" 
                                    CornerRadius="3" 
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" VerticalAlignment="Center"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#FCA5A5"/>
                                <Setter Property="Foreground" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Menu Items Style -->
        <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,12"/>
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Border" 
                                                Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                Padding="{TemplateBinding Padding}" 
                                                SnapsToDevicePixels="true">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="Indicator" 
                                                HorizontalAlignment="Left" 
                                                Width="4" 
                                                Height="18" 
                                                Background="#3B82F6" 
                                                CornerRadius="2" 
                                                VerticalAlignment="Center" 
                                                Visibility="Collapsed" 
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="Border" Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="true">
                                            <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Profiles ListBox Style -->
        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="8" 
                                            Padding="{TemplateBinding Padding}" 
                                            SnapsToDevicePixels="true">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="true">
                                            <Setter TargetName="Border" Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Sidebar Header (Logo & Brand) -->
                <StackPanel Grid.Row="0" Margin="0,10,0,30">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Modern Pie Icon -->
                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                            <Ellipse Fill="#EBF5FF" Width="32" Height="32"/>
                            <Path Fill="#3B82F6" Stretch="Uniform" Margin="6"
                                  Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,4.06c3.95,0.49,7,3.85,7,7.94h-7V4.06z M11,4.06v7.94H4c0-4.09,3.05-7.45,7-7.94z M4,13h7v7.94c-3.95-0.49-7-3.85-7-7.94z M13,20.94V13h7C20,17.09,16.95,20.45,13,20.94z"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="WinPieGestures" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <TextBlock Text="鼠标轮盘笔势管理系统" FontSize="11" Foreground="#64748B" Margin="2,0,0,0"/>
                </StackPanel>
                
                <!-- Navigation Items -->
                <ListBox Grid.Row="1" x:Name="SidebarMenuListBox" Style="{StaticResource SidebarListBoxStyle}" SelectionChanged="SidebarMenuListBox_SelectionChanged">
                    <ListBoxItem Tag="0" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=Foreground}" 
                                  Data="M12,4c-4.41,0-8,3.59-8,8s3.59,8,8,8c1.7,0,3.27-.53,4.56-1.44l1.43,1.43C16.36,21.36,14.28,22,12,22C6.48,22,2,17.52,2,12 S6.48,2,12,2c2.28,0,4.36.64,6.13,1.75l-1.43,1.43C15.41,4.53,13.8,4,12,4z M12,10c-1.1,0-2,.9-2,2s.9,2,2,2s2-.9,2-2S13.1,10,12,10z M21.19,10 L19,10l-2.03-1.58c-.18-.14-.23-.41-.12-.61l1.92-3.32c.12-.22.37-.29.59-.22l2.39.96c.5-.38,1.03-.7,1.62-.94l.36-2.54 C24.03,2.57,24.23,2.4,24.47,2.4H28.31c.24,0,.44,.17,.47,.41l.36,2.54c.59,.24,1.13,.56,1.62,.94l2.39-.96c.22-.07,.47,0,.59,.22l1.92,3.32 c.12,.21,.07,.47-.12,.61L33.5,10h-2.19v2h2.19l2.03,1.58c.18,.14,.23,.41,.12,.61l-1.92,3.32c-.12,.22-.37,.29-.59,.22l-2.39-.96 c-.5,.38-1.03,.7-1.62,.94l-.36,2.54c-.05,.24-.24,.41-.48,.41H24.5c-.24,0-.44-.17-.47-.41l-.36-2.54c-.59-.24-1.13-.56-1.62-.94l-2.39,.96 c-.22,.07-.47,0-.59-.22l-1.92-3.32c-.12-.21-.07-.47,.12-.61l2.03-1.58H21.19v-2z"/>
                            <TextBlock Text="常规与触发" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=Foreground}" 
                                  Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8s3.59-8,8-8s8,3.59,8,8 S16.41,20,12,20z M12,8c-2.21,0-4,1.79-4,4s1.79,4,4,4s4-1.79,4-4S14.21,8,12,8z"/>
                            <TextBlock Text="轮盘几何" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=Foreground}" 
                                  Data="M4,6c0-1.1,0.9-2,2-2h12c1.1,0,2,0.9,2,2v12c0,1.1-0.9,2-2,2H6c-1.1,0-2-0.9-2-2V6z M6,8h12V6H6V8z M6,12h12v-2H6V12z M6,16h6v-2H6V16z"/>
                            <TextBlock Text="手势与按键" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=Foreground}" 
                                  Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                            <TextBlock Text="关于与更新日志" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                
                <!-- Version Footer -->
                <StackPanel Grid.Row="2" Margin="0,20,0,10">
                    <TextBlock Text="WinPieGestures v1.1.0" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="4,0,0,2"/>
                    <TextBlock Text="© 2026 WinPieGestures" FontSize="10" Foreground="#94A3B8" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Right Main Panel -->
        <Grid Grid.Column="1" Margin="30,30,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Tab Pages -->
            <Grid Grid.Row="0">
                <!-- PAGE 0: GENERAL & TRIGGER -->
                <Grid x:Name="GeneralSettingsGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="常规与触发设置" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="在此配置全局鼠标手势的触发灵敏度、主题颜色和视觉显示效果。" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- UAC Privilege Warning Card -->
                            <Border x:Name="UacWarningCard" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.02"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Width="16" Height="16" Fill="#D97706" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Data="M12,2L1,21H23L12,2M12,6L19.8,19.2H4.2L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z"/>
                                            <TextBlock Text="权限提示：当前为普通用户权限" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="鼠标钩子在以管理员身份运行的程序窗口（如任务管理器、PowerShell终端）中可能无法触发笔势手势或发送模拟热键。建议以管理员权限启动。" FontSize="11" Foreground="#B45309" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="提升管理员权限" Style="{StaticResource PrimaryButtonStyle}" Background="#D97706" Foreground="White" Width="130" Height="32" Click="ElevatePrivileges_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Card 1: Trigger Sensitivity -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="触发与手势灵敏度" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,15"/>
                                    
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="触发位移阈值 (像素)" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="鼠标在按下热键后移动多少像素才唤出笔势轮盘。值越小越灵敏。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Slider Name="ThresholdSlider" Width="140" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" 
                                                    Style="{StaticResource FlatSliderStyle}" ValueChanged="ThresholdSlider_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock Name="ThresholdValueLabel" Text="25" Width="30" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Card 2: Visual Themes & Styles -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="颜色主题与视觉样式" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,15"/>
                                    
                                    <!-- Theme Selection Row -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="颜色主题" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="选择轮盘默认的背景和边框颜色风格。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox Name="ThemeComboBox" Grid.Column="1" Width="180" Height="32" Style="{StaticResource FlatComboBoxStyle}" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="跟随系统" Tag="System"/>
                                            <ComboBoxItem Content="深色模式 (黑)" Tag="Dark"/>
                                            <ComboBoxItem Content="浅色模式 (白)" Tag="Light"/>
                                            <ComboBoxItem Content="自定义颜色" Tag="Custom"/>
                                        </ComboBox>
                                    </Grid>
                                    
                                    <!-- Custom Color Picker Sub-Panel -->
                                    <StackPanel Name="CustomColorsPanel" Visibility="Collapsed" Margin="0,0,0,15">
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- BG & Border (Default) -->
                                                <StackPanel Margin="0,0,10,12">
                                                    <TextBlock Text="默认背景 (HEX):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Name="CustomSectorBgTextBox" Height="32" VerticalContentAlignment="Center" TextChanged="CustomColorTextBox_TextChanged"/>
                                                        <Button Grid.Column="1" Name="CustomSectorBgPicker" Width="36" Height="32" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="ColorPicker_Click" ToolTip="打开调色板">
                                                            <Border Name="CustomSectorBgPreview" Width="16" Height="16" CornerRadius="3" BorderBrush="#88FFFFFF" BorderThickness="1" Background="#9016161A"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                                    <TextBlock Text="默认边框 (HEX):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Name="CustomSectorBorderTextBox" Height="32" VerticalContentAlignment="Center" TextChanged="CustomColorTextBox_TextChanged"/>
                                                        <Button Grid.Column="1" Name="CustomSectorBorderPicker" Width="36" Height="32" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="ColorPicker_Click" ToolTip="打开调色板">
                                                            <Border Name="CustomSectorBorderPreview" Width="16" Height="16" CornerRadius="3" BorderBrush="#88FFFFFF" BorderThickness="1" Background="#35FFFFFF"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                                
                                                <!-- BG & Border (Highlight) -->
                                                <StackPanel Grid.Row="1" Margin="0,0,10,12">
                                                    <TextBlock Text="高亮背景 (HEX):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                    <TextBox Name="CustomHighlightBgTextBox" Height="32" VerticalContentAlignment="Center" TextChanged="CustomColorTextBox_TextChanged"/>
                                                    <Button Grid.Column="1" Name="CustomHighlightBgPicker" Width="36" Height="32" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="ColorPicker_Click" ToolTip="打开调色板">
                                                        <Border Name="CustomHighlightBgPreview" Width="16" Height="16" CornerRadius="3" BorderBrush="#88FFFFFF" BorderThickness="1" Background="#E06C4DFF"/>
                                                    </Button>
                                                    </Grid>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                                                    <TextBlock Text="高亮边框 (HEX):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Name="CustomHighlightBorderTextBox" Height="32" VerticalContentAlignment="Center" TextChanged="CustomColorTextBox_TextChanged"/>
                                                        <Button Grid.Column="1" Name="CustomHighlightBorderPicker" Width="36" Height="32" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="ColorPicker_Click" ToolTip="打开调色板">
                                                            <Border Name="CustomHighlightBorderPreview" Width="16" Height="16" CornerRadius="3" BorderBrush="#88FFFFFF" BorderThickness="1" Background="#A0FFFFFF"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                                
                                                <!-- Text Color -->
                                                <StackPanel Grid.Row="2" Margin="0,0,10,0">
                                                    <TextBlock Text="文字颜色 (HEX):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Name="CustomTextTextBox" Height="32" VerticalContentAlignment="Center" TextChanged="CustomColorTextBox_TextChanged"/>
                                                        <Button Grid.Column="1" Name="CustomTextPicker" Width="36" Height="32" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="ColorPicker_Click" ToolTip="打开调色板">
                                                            <Border Name="CustomTextPreview" Width="16" Height="16" CornerRadius="3" BorderBrush="#88FFFFFF" BorderThickness="1" Background="#E0FFFFFF"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- UI Style Selection Row -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="UI 视觉风格" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="改变轮盘的整体渲染风格细节。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox Name="UiStyleComboBox" Grid.Column="1" Width="180" Height="32" Style="{StaticResource FlatComboBoxStyle}" SelectionChanged="UiStyleComboBox_SelectionChanged" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="经典圆环" Tag="ClassicRing"/>
                                            <ComboBoxItem Content="简洁扇区" Tag="CleanSectors"/>
                                            <ComboBoxItem Content="毛玻璃效果" Tag="Glassmorphism"/>
                                            <ComboBoxItem Content="霓虹发光 (科技)" Tag="NeonGlow"/>
                                            <ComboBoxItem Content="萌宠猫爪" Tag="CatPaw"/>
                                            <ComboBoxItem Content="重工业机械" Tag="Mechanical"/>
                                        </ComboBox>
                                    </Grid>
                                    
                                    <Separator Background="#F1F5F9" Margin="0,5,0,15"/>
                                    
                                    <!-- Show Text Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="在轮盘上显示文字" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="若关闭，则在轮盘内只显示软件原生图标或功能图标，进入纯净图标模式。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Name="ShowTextCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                                  Checked="ShowTextCheckBox_Changed" Unchecked="ShowTextCheckBox_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Scene Isolation Settings -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="触发场景隔离设置" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,15"/>
                                    
                                    <!-- Full Screen Block Switch -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="全屏游戏/应用中禁用" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="当活动窗口为全屏模式时，自动静默禁用手势轮盘以避免误触。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Name="DisableOnFullScreenCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                                  Checked="DisableOnFullScreenCheckBox_Changed" Unchecked="DisableOnFullScreenCheckBox_Changed"/>
                                    </Grid>
                                    
                                    <Separator Background="#F1F5F9" Margin="0,5,0,15"/>

                                    <!-- Modifier Keys Switch -->
                                    <TextBlock Text="快捷禁用修饰键" FontSize="13" FontWeight="Medium" Foreground="#1E293B" Margin="0,0,0,8"/>
                                    <TextBlock Text="按住勾选的修饰键时进行右键点击，将跳过轮盘并传递原生右键功能。" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <CheckBox Name="CtrlModifierCheckBox" Content="Ctrl 键" Margin="0,0,20,0" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                        <CheckBox Name="ShiftModifierCheckBox" Content="Shift 键" Margin="0,0,20,0" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                        <CheckBox Name="AltModifierCheckBox" Content="Alt 键" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                    </StackPanel>

                                    <Separator Background="#F1F5F9" Margin="0,5,0,15"/>

                                    <!-- Process Blacklist -->
                                    <TextBlock Text="进程排除黑名单" FontSize="13" FontWeight="Medium" Foreground="#1E293B" Margin="0,0,0,5"/>
                                    <TextBlock Text="在以下应用程序中右键拖拽将不会触发任何轮盘手势（支持添加或移除进程，如 chrome.exe）。" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- ListBox showing current blacklist -->
                                        <ListBox Name="BlacklistListBox" Grid.Row="0" Grid.Column="0" Height="100" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,8"/>
                                        
                                        <!-- Action buttons for list -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,8" VerticalAlignment="Top">
                                            <Button Name="DeleteBlacklistButton" Content="删除选中" Width="80" Height="30" Margin="0,0,0,8" Style="{StaticResource ModernButtonStyle}" Click="DeleteBlacklistButton_Click"/>
                                        </StackPanel>
                                        
                                        <!-- Input box to add new process -->
                                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Name="NewBlacklistProcessTextBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="输入进程名，例如: photoshop.exe"/>
                                            <Button Grid.Column="1" Name="AddBlacklistButton" Content="添加进程" Width="80" Height="32" Style="{StaticResource PrimaryButtonStyle}" Click="AddBlacklistButton_Click"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                
                <!-- PAGE 1: WHEEL GEOMETRY -->
                <Grid x:Name="GeometrySettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="轮盘几何参数" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="调整鼠标手势轮盘各部分的物理半径、核心空心大小及按键物理外观。" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 1: Radii Settings -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="尺寸与比例微调" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,15"/>
                                    
                                    <!-- Outer Radius -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="轮盘整体大小" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="轮盘的外围物理半径。值越大，手势轮盘整体显示面积越大。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Slider Name="WheelRadiusSlider" Width="150" Minimum="100" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" 
                                                    Style="{StaticResource FlatSliderStyle}" ValueChanged="WheelRadiusSlider_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock Name="WheelRadiusLabel" Text="138" Width="30" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Inner Radius -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="内圆半径" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="控制轮盘各功能扇区至中心的空白距离，即内边距半径。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Slider Name="InnerRadiusSlider" Width="150" Minimum="0" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" 
                                                    Style="{StaticResource FlatSliderStyle}" ValueChanged="InnerRadiusSlider_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock Name="InnerRadiusLabel" Text="52" Width="30" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Core Radius -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="核心圆大小" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="位于轮盘正中心圆盘的半径，调整中间按钮部分的遮罩大小。" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Slider Name="CoreRadiusSlider" Width="150" Minimum="25" Maximum="75" TickFrequency="1" IsSnapToTickEnabled="True" 
                                                    Style="{StaticResource FlatSliderStyle}" ValueChanged="CoreRadiusSlider_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock Name="CoreRadiusLabel" Text="50" Width="30" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Card 2: Physical Shape -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="按键物理形状" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,15"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
