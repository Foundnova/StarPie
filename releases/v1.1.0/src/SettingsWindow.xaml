                                            <TextBlock Text="全局低级鼠标钩子、4/8/12 键轮盘布局、模拟热键与程序启动执行引擎。" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="2026-06-01" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Action Shortcuts -->
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="快捷与维护动作" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Name="OpenReleasesFolderButton" Content="打开发布归档目录" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,10,10" Click="OpenReleasesFolderButton_Click"/>
                                        <Button Name="OpenAppFolderButton" Content="打开应用所在位置" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,10,10" Click="OpenAppFolderButton_Click"/>
                                        <Button Content="以管理员权限重启" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,10,10" Click="ElevatePrivileges_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            
            <!-- Global Bottom Action Footer -->
            <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="注: 所有修改均在内存中即时保存，但在点击【保存更改】前不会持久化到硬盘中。" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    
                    <Button x:Name="SaveButton" Grid.Column="1" Content="保存更改" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="36" Click="SaveButton_Click" Margin="0,0,10,0"/>
                    <Button x:Name="CloseButton" Grid.Column="2" Content="关闭并隐藏" Style="{StaticResource ModernButtonStyle}" Width="100" Height="36" Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
