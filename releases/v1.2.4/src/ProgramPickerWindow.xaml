<Window x:Class="WinPieGestures.ProgramPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择程序 - WinPieGestures" 
        Height="500" Width="400"
        Background="#F4F4F9"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Info -->
            <RowDefinition Height="Auto"/> <!-- Search Box -->
            <RowDefinition Height="*"/>    <!-- Programs List -->
            <RowDefinition Height="Auto"/> <!-- Status / Loading indicator -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="从已安装的软件和开始菜单中选择" FontSize="14" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
        
        <!-- Search bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="SearchTextBox" Height="28" VerticalContentAlignment="Center" Padding="5,0" 
                     TextChanged="SearchTextBox_TextChanged">
                <TextBox.Resources>
                    <!-- Small hack for placeholder text in WPF -->
                    <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                        <VisualBrush.Visual>
                            <TextBlock Text=" 搜索软件或可执行程序..." Foreground="#888888" FontStyle="Italic" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </TextBox.Resources>
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>
        
        <!-- List View -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ListView Name="ProgramsListView" BorderThickness="0" Background="Transparent" 
                      MouseDoubleClick="ProgramsListView_MouseDoubleClick" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5" Height="44">
                            <Image Source="{Binding IconSource}" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#333333"/>
                                <TextBlock Text="{Binding FriendlyPath}" FontSize="9" Foreground="#888888" TextTrimming="CharacterEllipsis" Width="300"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Loading / Status indicator -->
        <TextBlock Grid.Row="3" Name="StatusTextBlock" Text="正在扫描系统中的软件，请稍候..." 
                   Foreground="#3351B5" Margin="0,5,0,5" FontWeight="Medium" Visibility="Visible"/>
        
        <!-- Bottom Actions -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="手动浏览文件..." Width="120" Height="30" Click="ManualBrowse_Click" Background="#E0E0E0" BorderThickness="0"/>
            <Button Grid.Column="2" Content="确定" Width="80" Height="30" Click="Ok_Click" Background="#3F51B5" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="取消" Width="80" Height="30" Click="Cancel_Click" Background="#E0E0E0" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
